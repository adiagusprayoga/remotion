{
  "meta": {
    "title": "Remotion Motion Studio",
    "fps": 30,
    "width": 1920,
    "height": 1080
  },
  "theme": {
    "fontFamily": "'Inter', 'Segoe UI', system-ui, sans-serif",
    "textColor": "#f8fafc",
    "accentColor": "#818cf8",
    "palette": [
      ["#0f172a", "#1e293b", "#312e81"],
      ["#111827", "#1f2937", "#4c1d95"],
      ["#0b1120", "#172554", "#1e3a8a"]
    ]
  },
  "scenes": [
    {
      "id": "intro",
      "durationInFrames": 90,
      "transition": "fade",
      "background": {
        "type": "gradient",
        "colors": ["#0f172a", "#1e293b", "#312e81"],
        "angle": 135
      },
      "title": "Remotion Motion Studio",
      "subtitle": "Tulis prompt, dapatkan video motion",
      "animation": "fadeUp",
      "accentColor": "#818cf8"
    },
    {
      "id": "scene-1",
      "durationInFrames": 105,
      "transition": "slide",
      "background": {
        "type": "gradient",
        "colors": ["#111827", "#1f2937", "#4c1d95"],
        "angle": 135
      },
      "title": "Cara Kerja",
      "bulletPoints": [
        "Tulis prompt bebas di terminal",
        "Generator menyusun storyboard",
        "Remotion merender jadi MP4"
      ],
      "animation": "slideLeft",
      "accentColor": "#818cf8"
    },
    {
      "id": "scene-2",
      "durationInFrames": 105,
      "transition": "wipe",
      "background": {
        "type": "gradient",
        "colors": ["#0b1120", "#172554", "#1e3a8a"],
        "angle": 135
      },
      "title": "Bisa Dikustom",
      "bulletPoints": [
        "Tema warna otomatis",
        "Transisi antar scene",
        "Animasi teks beragam"
      ],
      "animation": "scaleIn",
      "accentColor": "#818cf8"
    },
    {
      "id": "outro",
      "durationInFrames": 90,
      "transition": "fade",
      "background": {
        "type": "gradient",
        "colors": ["#1e293b", "#312e81", "#4c1d95"],
        "angle": 135
      },
      "title": "Siap Dipakai",
      "subtitle": "npm run video:render -- --prompt \"...\"",
      "animation": "fadeUp",
      "accentColor": "#818cf8"
    }
  ]
}
